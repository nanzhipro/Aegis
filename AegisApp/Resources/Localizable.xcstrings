    "aegis.onboarding.permissions.body" : {
      "comment" : "Description for the readiness and permissions onboarding step.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aegis needs a system extension, a login item, and local policy defaults before folder protection is fully active."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ保護を有効にするには、System Extension、Login Item、ローカルポリシーの初期値が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在文件夹保护真正生效前，Aegis 需要 System Extension、Login Item 和本地策略默认值就位。"
          }
        }
      }
    },
