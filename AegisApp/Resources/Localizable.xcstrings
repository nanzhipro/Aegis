    "aegis.onboarding.welcome.body" : {
      "comment" : "Description for the onboarding welcome step.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aegis stays local on this Mac and guides the first setup steps before protection turns on."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aegis はこの Mac 上だけで動作し、保護を有効にする前に初回設定を案内します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aegis 仅在这台 Mac 本地运行，并在真正开启保护前引导你完成首次设置。"
          }
        }
      }
    },
