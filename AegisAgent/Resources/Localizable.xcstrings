    "aegis.agent.subtitle" : {
      "comment" : "Subtitle describing the agent prompt center purpose.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receive prompt requests, reply with allow or deny, and optionally remember the decision locally."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認要求を受け取り、許可または拒否で応答し、必要に応じて判断をローカル保存します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接收确认请求，返回允许或拒绝，并按需在本地记住这次决策。"
          }
        }
      }
    },
